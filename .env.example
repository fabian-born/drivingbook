# ============================================================
# Fahrtenbuch – Umgebungsvariablen
# Kopieren nach: .env  (niemals .env in Git einchecken!)
# ============================================================

# ── Datenbank ────────────────────────────────────────────────
DB_NAME=fahrtenbuch
DB_USER=fahrtenbuch

# WICHTIG: Starkes Passwort setzen!
DB_PASSWORD=CHANGE_ME

# ── JWT ──────────────────────────────────────────────────────
# Pflicht, mindestens 32 zufällige Zeichen, z.B. generieren mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Gültigkeitsdauer des JWT-Tokens (z.B. 8h, 24h, 7d)
JWT_EXPIRES=8h

# ── Admin (nur beim ersten Start auf leerer Datenbank) ───────
# Ohne ADMIN_PASSWORD wird ein Zufallspasswort erzeugt und einmalig geloggt.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Sicherheit ───────────────────────────────────────────────
# Erlaubte Frontend-Origin(s), kommagetrennt. Nur nötig, wenn das Frontend
# die API von einer anderen Origin aufruft (Standard: gleiche Origin über nginx).
CORS_ORIGIN=
# Öffentliche Registrierung erlauben (true/false)
ALLOW_REGISTRATION=true
# Anzahl Reverse-Proxys vor dem Backend: 1 = nur Frontend-nginx,
# 2 = Traefik + nginx (Homelab-Stack)
TRUST_PROXY=1

# ── Geocoding ────────────────────────────────────────────────
# Kontaktadresse für Nominatim (OpenStreetMap), empfohlen laut Nutzungsbedingungen
NOMINATIM_EMAIL=

# ── Backups ──────────────────────────────────────────────────
# Wie viele Tage tägliche Datenbank-Backups aufbewahrt werden
BACKUP_KEEP_DAYS=14

# ── Ports ────────────────────────────────────────────────────
FRONTEND_PORT=80
