# ============================================================
# Fahrtenbuch – Umgebungsvariablen
# Kopieren nach: .env  (niemals .env in Git einchecken!)
# ============================================================

# ── Datenbank ────────────────────────────────────────────────
DB_NAME=fahrtenbuch
DB_USER=fahrtenbuch

# WICHTIG: Starkes Passwort setzen!
DB_PASSWORD=CHANGE_ME

# ── JWT ──────────────────────────────────────────────────────
# Pflicht, mindestens 32 zufällige Zeichen, z.B. generieren mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Gültigkeitsdauer des JWT-Tokens (z.B. 8h, 24h, 7d)
JWT_EXPIRES=8h

# ── Admin (nur beim ersten Start auf leerer Datenbank) ───────
# Ohne ADMIN_PASSWORD wird ein Zufallspasswort erzeugt und einmalig geloggt.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ── Sicherheit ───────────────────────────────────────────────
# Erlaubte Frontend-Origin(s), kommagetrennt. Leer = alle (nicht empfohlen).
CORS_ORIGIN=https://fahrtenbuch.example.com
# Öffentliche Registrierung erlauben (true/false)
ALLOW_REGISTRATION=true
# Anzahl Reverse-Proxys vor dem Backend (z.B. 1 bei Traefik), leer = keiner
TRUST_PROXY=

# ── Ports ────────────────────────────────────────────────────
BACKEND_PORT=3000
FRONTEND_PORT=80
