# ============================================================
# Fahrtenbuch – demo environment
# Copy to: demo/.env  (never commit .env to Git!)
# ============================================================

# ── Images ───────────────────────────────────────────────────
# Tags from the CI (e.g. 2026.09.23-ab12cd34)
FRONTEND_TAG=
BACKEND_TAG=

# ── Traefik ──────────────────────────────────────────────────
DEMO_DOMAIN=demo.fahrtenbuch.example.com
TRAEFIK_CERTRESOLVER=hetzner

# ── Database / JWT ───────────────────────────────────────────
# Use separate values, do not reuse the production ones!
DB_PASSWORD=CHANGE_ME
# At least 32 random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES=2h

# ── Demo logins ──────────────────────────────────────────────
# User "demo" (regular role) – this password is shown publicly
DEMO_PASSWORD=demo
# User "admin" – leave empty for no demo admin
DEMO_ADMIN_PASSWORD=

# ── Reset ────────────────────────────────────────────────────
# Minutes between two resets
RESET_INTERVAL_MINUTES=60

# ── Other ────────────────────────────────────────────────────
# Sign-up of new users (their data is deleted on reset)
ALLOW_REGISTRATION=false
NOMINATIM_EMAIL=
