<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Cache-Control" content="no-cache, no-store, must-revalidate" />
<meta http-equiv="Pragma" content="no-cache" />
<meta http-equiv="Expires" content="0" />
<title>Fahrtenbuch – Jahreshistorie</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
</head>
<body class="bg-light">

<nav class="navbar navbar-expand-lg navbar-dark bg-dark">
  <div class="container-fluid">
    <a class="navbar-brand fw-bold" href="index.html">Fahrtenbuch</a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
      aria-controls="navbarNav" aria-expanded="false" aria-label="Menü öffnen">
      <span class="navbar-toggler-icon"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNav">
      <ul class="navbar-nav ms-auto">
        <li class="nav-item"><a class="nav-link" href="driving.html">Neue Fahrt</a></li>
        <li class="nav-item"><a class="nav-link" href="view.html">Fahrten anzeigen</a></li>
	<li class="nav-item"><a class="nav-link active" aria-current="page" href="history.html">Jahreshistorie</a></li>
        <li class="nav-item"><a class="nav-link" href="index.html">Dashboard</a></li>
      </ul>
      <button id="logoutBtn" class="btn btn-outline-light btn-sm ms-2">Logout</button>
    </div>
  </div>
</nav>

<div class="container py-5">
  <div class="d-flex align-items-center justify-content-between flex-wrap gap-3 mb-4">
    <h2 class="mb-0">Jahreshistorie</h2>
    <div class="d-flex align-items-center gap-2">
      <label for="historyJahrSelect" class="form-label mb-0 fw-semibold">Jahr:</label>
      <select id="historyJahrSelect" class="form-select" style="width: auto;"></select>
      <button id="historyCSVExport" class="btn btn-outline-secondary">CSV Export</button>
    </div>
  </div>

  <div id="historyLoading" class="text-center py-5">
    <div class="spinner-border text-primary" role="status">
      <span class="visually-hidden">Wird geladen...</span>
    </div>
    <p class="mt-3 text-muted">Daten werden geladen...</p>
  </div>

  <div id="historyContent" class="d-none"></div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="js/auth-check.js"></script>
<script src="js/config.js"></script>
<script src="js/dashboard-history.js"></script>

<footer class="bg-dark text-light mt-5">
  <div class="container py-3 text-center small">
    © <span id="year"></span> Fahrtenbuch · Version <span id="appVersion">-</span>
  </div>
</footer>

<script>
  document.getElementById("year").innerText = new Date().getFullYear();
</script>
<script src="js/footer.js"></script>
</body>
</html>
